# Optional alternative/override to sshuptime.yaml. Copy to .env in your cwd.
# Precedence: CLI > real environment > .env > YAML > defaults.
# Paths in .env/environment are relative to the working directory.
SSHUPTIME_SSH__HOST=127.0.0.1
SSHUPTIME_SSH__PORT=8022
SSHUPTIME_SSH__USERNAME=monitor
SSHUPTIME_SSH__HOST_KEY=./ssh_host_ed25519_key
SSHUPTIME_SSH__AUTHORIZED_KEYS=./dashboard_authorized_keys
SSHUPTIME_DASHBOARD__MODE=live
SSHUPTIME_DASHBOARD__THEME=sshuptime
SSHUPTIME_DASHBOARD__INTERVAL=2

# Optional source connection overrides:
# SSHUPTIME_SOURCES__PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# SSHUPTIME_SOURCES__KUBECONFIG=~/.kube/config
# SSHUPTIME_SOURCES__KUBE_CONTEXT=my-context
# SSHUPTIME_SOURCES__REQUEST_TIMEOUT=3
# SSHUPTIME_SOURCES__LOG_LINES=40
# SSHUPTIME_SOURCES__LOG_BYTES=32768
# SSHUPTIME_SOURCES__MAX_LOG_ITEMS=12
# SSHUPTIME_SOURCES__JOURNAL_LINES=50
# SSHUPTIME_SOURCES__CRON_HISTORY_LINES=500
